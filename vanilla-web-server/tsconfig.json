{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/*"],
      "@test/*": ["test/*"]
    }
  },
  "include": ["app/**/*.ts", "test/**/*.ts", "eslint.config.mts"],
  "exclude": ["dist"]
}
