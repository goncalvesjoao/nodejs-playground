{
  "name": "nodejs-playground",
  "version": "1.0.0",
  "type": "module",
  "description": "Minimal TypeScript Node.js web server using http.createServer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "concurrently 'npm run dev:backend' 'npm run dev:frontend'",
    "dev:backend": "tsx watch --include 'src/**/*.ts' src/index.ts",
    "dev:frontend": "vite",
    "start": "node dist/index.js",
    "test": "node scripts/test.mjs",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/country-list": "^2.1.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "prettier": "3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.2"
  },
  "dependencies": {
    "country-list": "^2.4.1",
    "ejs": "^5.0.1"
  }
}
