{
  "name": "nodejs-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal TypeScript Node.js web server using http.createServer",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint . --fix",
    "format": "prettier .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
