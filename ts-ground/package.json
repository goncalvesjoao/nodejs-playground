{
  "name": "ts-ground",
  "version": "1.0.0",
  "private": true,
  "description": "Testing ground for TypeScript code",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint . --fix",
    "format": "prettier .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
